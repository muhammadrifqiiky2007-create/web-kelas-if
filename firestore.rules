rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprints
    function isValidMember(data) {
      return data.keys().hasAll(['name', 'photoData', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.photoData is string && data.photoData.size() <= 800000 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time &&
             ( !data.keys().hasAny(['nim']) || (data.nim is string && data.nim.size() <= 50) ) &&
             ( !data.keys().hasAny(['instagram']) || (data.instagram is string && data.instagram.size() <= 50) ) &&
             ( !data.keys().hasAny(['role']) || (data.role is string && data.role.size() <= 50) );
    }

    function isValidMemberUpdate(data, oldData) {
      return data.name is string && data.name.size() <= 100 &&
             data.photoData is string && data.photoData.size() <= 800000 &&
             data.createdAt == oldData.createdAt &&
             data.updatedAt == request.time &&
             ( !data.keys().hasAny(['nim']) || (data.nim is string && data.nim.size() <= 50) ) &&
             ( !data.keys().hasAny(['instagram']) || (data.instagram is string && data.instagram.size() <= 50) ) &&
             ( !data.keys().hasAny(['role']) || (data.role is string && data.role.size() <= 50) );
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['title', 'description', 'photoData', 'date', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 500 &&
             data.photoData is string && data.photoData.size() <= 800000 &&
             data.date is string && data.date.size() <= 50 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidGalleryItemUpdate(data, oldData) {
      return data.title is string && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 500 &&
             data.photoData is string && data.photoData.size() <= 800000 &&
             data.date is string && data.date.size() <= 50 &&
             data.createdAt == oldData.createdAt &&
             data.updatedAt == request.time;
    }

    function isValidScheduleItem(data) {
      return data.keys().hasAll(['day', 'time', 'course', 'lecturer', 'room', 'createdAt', 'updatedAt']) &&
             data.day is string && data.day.size() <= 20 &&
             data.time is string && data.time.size() <= 50 &&
             data.course is string && data.course.size() <= 150 &&
             data.lecturer is string && data.lecturer.size() <= 150 &&
             data.room is string && data.room.size() <= 100 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidScheduleItemUpdate(data, oldData) {
      return data.day is string && data.day.size() <= 20 &&
             data.time is string && data.time.size() <= 50 &&
             data.course is string && data.course.size() <= 150 &&
             data.lecturer is string && data.lecturer.size() <= 150 &&
             data.room is string && data.room.size() <= 100 &&
             data.createdAt == oldData.createdAt &&
             data.updatedAt == request.time;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.email is string && data.email.size() <= 150 &&
             data.createdAt == request.time;
    }

    // Collections
    
    match /members/{memberId} {
      allow read: if true; // Public read
      allow create: if isAdmin() && isValidId(memberId) && isValidMember(incoming());
      allow update: if isAdmin() && isValidId(memberId) && isValidMemberUpdate(incoming(), existing());
      allow delete: if isAdmin() && isValidId(memberId);
    }

    match /gallery/{galleryId} {
      allow read: if true; // Public read
      allow create: if isAdmin() && isValidId(galleryId) && isValidGalleryItem(incoming());
      allow update: if isAdmin() && isValidId(galleryId) && isValidGalleryItemUpdate(incoming(), existing());
      allow delete: if isAdmin() && isValidId(galleryId);
    }

    match /schedule/{scheduleId} {
      allow read: if true; // Public read
      allow create: if isAdmin() && isValidId(scheduleId) && isValidScheduleItem(incoming());
      allow update: if isAdmin() && isValidId(scheduleId) && isValidScheduleItemUpdate(incoming(), existing());
      allow delete: if isAdmin() && isValidId(scheduleId);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      // Only super admin can create/delete admins, or admins can read themselves
      allow read: if isAdmin();
      allow create: if isSuperAdmin() && isValidId(adminId) && isValidAdmin(incoming());
      allow delete: if isSuperAdmin() && isValidId(adminId);
    }
  }
}
